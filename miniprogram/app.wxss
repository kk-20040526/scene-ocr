page {
  background: #f2f2f2;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}
.container {
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
}
.btn-ghost {
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 12rpx;
}
