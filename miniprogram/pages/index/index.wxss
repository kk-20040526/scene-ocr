.title {
  text-align: center;
  font-size: 38rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin: 12rpx 0 28rpx;
}
.label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
}
.server-row {
  display: flex;
  align-items: center;
}
.server-input {
  flex: 1;
  height: 68rpx;
  background: #f5f6f8;
  border-radius: 10rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}
.mini-btn {
  background: #07c160;
  color: #fff;
}
.btn-row {
  margin-bottom: 24rpx;
}
.big-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 18rpx;
}
.result-img {
  width: 100%;
  border-radius: 10rpx;
  background: #000;
}
.text-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.text-item:last-child {
  border-bottom: none;
}
.text-idx {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: #e7f9ef;
  color: #07c160;
  border-radius: 50%;
  font-size: 24rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.text-main {
  flex: 1;
}
.text-content {
  font-size: 30rpx;
  color: #1a1a1a;
  line-height: 1.4;
  word-break: break-all;
}
.text-score {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 6rpx;
}
.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 20rpx 0;
}
